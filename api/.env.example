# Copie para api/.env (não versionado) e preencha. A API lê este arquivo ao subir.
# Em produção (Render, Railway etc.), cadastre as mesmas variáveis no painel do serviço.

# Session pooler do Supabase (IPv4). Painel do Supabase → Connect → Session pooler.
# O host direto db.<projeto>.supabase.co só tem IPv6 e não funciona na maioria das redes/hosts.
DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.wryunefmcekdlttiddzr
DB_PASSWORD=

# Schema onde ficam as tabelas (criado pelo Flyway). Fora do "public" para não ser exposto pela Data API do Supabase.
DB_SCHEMA=sus360

# Origens do front liberadas no CORS (vírgula). Curingas são aceitos, ex.: https://*.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# PORT=8080

# Chave para assinar os tokens de login (mínimo 32 caracteres, aleatória e secreta).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do login (ex.: 24h, 7d)
JWT_EXPIRACAO=24h
